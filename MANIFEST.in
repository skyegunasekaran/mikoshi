include README.md EXPERIMENTS.md ARCHITECTURE.md SCHEMA.md AGENTS.md LICENSE THIRD_PARTY.md Makefile
include pyproject.toml MANIFEST.in
include .dockerignore
include assets/readme/swarm.svg
recursive-include tests *.py *.md
prune docs
prune examples
prune scripts
prune output
prune tmp
prune training
prune build
prune dist
global-exclude __pycache__ *.py[cod] .DS_Store .env .env.* *.pem *.key *.p12 *.pfx
